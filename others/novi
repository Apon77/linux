#!/bin/sh
[ -z "$1" ] && echo "Usage: $0 <filename>" && exit 1
FILE="$1"; touch "$FILE"

DIR=$(dirname "$FILE")
BUF="$DIR/.$$.novi_buffer.tmp"
INS="$DIR/.$$.novi_insert.tmp"
CLIP="$DIR/.$$.novi_clip.tmp"
cat "$FILE" > "$BUF"
touch "$CLIP"

restore_term() {
    stty icanon echo
    printf "\033[?25h\033[2J\033[H"
    rm -f "$BUF" "$INS" "$CLIP" "$BUF.tmp"
}
trap restore_term EXIT INT TERM

CUR=1; WIN=20; TOP=1; HELP=0; MSG=""; KBUF=""
printf "\033[2J"

while :; do
    TOT=$(awk 'END{print NR+0}' "$BUF")
    [ "$CUR" -gt "$TOT" ] && CUR="$TOT"
    [ "$CUR" -lt 1 ] && CUR=1
    [ "$CUR" -ge $((TOP + WIN)) ] && TOP=$((CUR - WIN + 1))
    [ "$CUR" -lt "$TOP" ] && TOP="$CUR"
    BOT=$((TOP + WIN - 1)); [ "$BOT" -gt "$TOT" ] && BOT="$TOT"

    # --- DRAW PHASE ---
    printf "\033[?25l\033[H"

    if [ "$TOT" -gt 0 ]; then
        awk -v s="$TOP" -v e="$BOT" -v c="$CUR" '
        NR>=s && NR<=e {
            printf "\033[K%s%d: %s\n", (NR == c ? "> " : "  "), NR, $0;
        }' "$BUF"
        LC=$((BOT - TOP + 1))
    else
        printf "\033[K  (file is empty)\n"
        LC=1
    fi

    pad=$((WIN - LC))
    while [ "$pad" -gt 0 ]; do
        printf "\033[K\n"
        pad=$((pad - 1))
    done

    if [ -n "$MSG" ]; then
        printf "\033[K%s\n" "$MSG"; MSG=""
    elif [ "$HELP" -eq 1 ]; then
        printf "\033[K[Help: j/k=Move f/b=Page gg/G=Jump i/I=Insert dd=Del y=Copy p=Paste :w :q :q!]\n"
    else
        printf "\033[KFile: %s | Line: %d/%d (h for help)\n" "$FILE" "$CUR" "$TOT"
    fi

    printf "\033[K:%s\033[?25h" "$KBUF"

    # --- INPUT PHASE ---
    CNT=""
    CMD=""
    while :; do
        stty -icanon -echo
        C=$(head -c 1 2>/dev/null)
        stty icanon echo
        
        if [ -z "$C" ]; then
            CMD="ENTER"
            break
        fi

        case "$C" in
            [0-9]) 
                CNT="${CNT}${C}"
                KBUF="${KBUF}${C}" 
                printf "\r\033[K:%s" "$KBUF" 
                ;;
            *)     
                CMD="$C"
                KBUF="${KBUF}${C}" 
                break 
                ;;
        esac
    done

    NV="$CNT"; [ -z "$CNT" ] && CNT=1

    case "$CMD" in
        ENTER)
            if [ -n "$NV" ]; then CUR="$NV"; fi
            ;;
        :)
            # Drop into structural colon input command line execution mode
            printf "\r\033[K:"
            stty icanon echo
            read COLON_CMD
            stty -icanon -echo
            
            case "$COLON_CMD" in
                w)
                    cat "$BUF" > "$FILE"
                    MSG="\"$FILE\" written to disk."
                    ;;
                q)
                    # Check for modifications before exiting safely
                    orig_hash=$(od -An -t x1 "$FILE" | tr -d ' \n\r')
                    curr_hash=$(od -An -t x1 "$BUF" | tr -d ' \n\r')
                    if [ "$orig_hash" = "$curr_hash" ]; then
                        break 2
                    else
                        MSG="No write since last change (add ! to override)"
                    fi
                    ;;
                q!|'q!')
                    break 2
                    ;;
                wq)
                    cat "$BUF" > "$FILE"
                    break 2
                    ;;
                *)
                    MSG="Not an editor command: :$COLON_CMD"
                    ;;
            esac
            ;;
        h) HELP=$((1 - HELP)) ;;
        j) CUR=$((CUR + CNT)) ;;
        k) CUR=$((CUR - CNT)) ;;
        f) CUR=$((CUR + WIN * CNT)) ;;
        b) CUR=$((CUR - WIN * CNT)) ;;
        g)
            stty -icanon -echo; NX=$(head -c 1 2>/dev/null); stty icanon echo
            [ "$NX" = "g" ] && CUR="${NV:-1}"
            ;;
        G) CUR="${NV:-$TOT}" ;;
        y)
            if [ "$TOT" -gt 0 ]; then
                END_YANK=$((CUR + CNT - 1))
                awk -v s="$CUR" -v e="$END_YANK" 'NR>=s && NR<=e' "$BUF" > "$CLIP"
                MSG="Yanked $CNT line(s) to clipboard."
            fi
            ;;
        p)
            if [ -s "$CLIP" ]; then
                sed -i "${CUR}r $CLIP" "$BUF"
                MSG="Pasted block below line $CUR."
            fi
            ;;
        i|I)
            mode="AFTER"; [ "$CMD" = "I" ] && mode="BEFORE"
            printf "\033[2J\033[H-- INSERT %s LINE %d --\n(Type block, press Enter then Ctrl+D to finish)\n" "$mode" "$CUR"
            cat > "$INS"
            if [ -s "$INS" ]; then
                if [ "$CMD" = "i" ]; then
                    sed -i "${CUR}r $INS" "$BUF"
                    CUR=$((CUR + 1))
                else
                    if [ "$CUR" -le 1 ]; then
                        cat "$INS" "$BUF" > "$BUF.tmp" && mv "$BUF.tmp" "$BUF"
                    else
                        sed -i "$((CUR - 1))r $INS" "$BUF"
                    fi
                fi
            fi
            rm -f "$INS"; printf "\033[2J"
            ;;
        d)
            stty -icanon -echo; NX=$(head -c 1 2>/dev/null); stty icanon echo
            if [ "$NX" = "d" ] && [ "$TOT" -gt 0 ]; then
                END_DEL=$((CUR + CNT - 1))
                awk -v s="$CUR" -v e="$END_DEL" 'NR>=s && NR<=e' "$BUF" > "$CLIP"
                sed -i "${CUR},${END_DEL}d" "$BUF"
            fi
            ;;
    esac

    KBUF=""
done

