#!/bin/sh

FILE="$1"
if [ -z "$FILE" ]; then
    echo "Usage: $0 <filename>"
    exit 1
fi

touch "$FILE"

DIR=$(dirname "$FILE")
BUFFER="$DIR/.$$.novi_buffer.tmp"
cat "$FILE" > "$BUFFER"

INSERT_TMP="$DIR/.$$.novi_insert.tmp"
OUT_TMP="$DIR/.$$.novi_out.tmp"

restore_term() {
    stty icanon echo
    rm -f "$BUFFER" "$INSERT_TMP" "$OUT_TMP"
}
trap restore_term EXIT INT TERM

START_LINE=1
WINDOW_SIZE=20

while true; do
    TOTAL_LINES=$(awk 'END {print NR}' "$BUFFER")
    [ -z "$TOTAL_LINES" ] && TOTAL_LINES=0
    
    END_LINE=$((START_LINE + WINDOW_SIZE - 1))
    if [ "$END_LINE" -gt "$TOTAL_LINES" ]; then
        END_LINE=$TOTAL_LINES
    fi

    clear
    echo "========================================================="
    echo " File: $FILE | Lines: $START_LINE-$END_LINE of $TOTAL_LINES (novi Mode)"
    echo "========================================================="
    
    if [ "$TOTAL_LINES" -gt 0 ]; then
        awk -v start="$START_LINE" -v end="$END_LINE" 'NR>=start && NR<=end {print NR ": " $0}' "$BUFFER"
    else
        echo "(file is empty)"
    fi
    
    echo "========================================================="
    echo " Nav:  [j] Down 20   [k] Up 20     [G] Jump to Line"
    echo " Keys: [i] Append    [I] Insert    [5dd] Delete X Lines  [s] Search"
    echo " Exit: [w] Save      [q] Quit      [x] Save & Exit"
    echo "========================================================="
    echo -n ":"
    
    # Initialize count tracking
    COUNT=""
    
    # Accumulator loop for processing leading numbers (e.g., 5dd)
    while true; do
        stty -icanon -echo
        CHAR=$(dd bs=1 count=1 2>/dev/null)
        stty icanon echo
        
        case "$CHAR" in
            [0-9])
                COUNT="${COUNT}${CHAR}"
                echo -n "$CHAR"
                ;;
            *)
                CMD="$CHAR"
                break
                ;;
        esac
    done

    # Default count to 1 if no number was typed
    [ -z "$COUNT" ] && COUNT=1

    case "$CMD" in
        j)
            # Apply scrolling multiplier based on the number pressed
            SCROLL_AMT=$((WINDOW_SIZE * COUNT))
            START_LINE=$((START_LINE + SCROLL_AMT))
            if [ "$START_LINE" -gt "$TOTAL_LINES" ]; then
                START_LINE=$((TOTAL_LINES - WINDOW_SIZE + 1))
            fi
            [ "$START_LINE" -lt 1 ] && START_LINE=1
            ;;
        k)
            SCROLL_AMT=$((WINDOW_SIZE * COUNT))
            START_LINE=$((START_LINE - SCROLL_AMT))
            [ "$START_LINE" -lt 1 ] && START_LINE=1
            ;;
        G)
            echo -n "Jump to which line number? "
            read JUMP_LINE
            if [ -n "$JUMP_LINE" ] && [ "$JUMP_LINE" -le "$TOTAL_LINES" ] && [ "$JUMP_LINE" -gt 0 ]; then
                START_LINE=$JUMP_LINE
            fi
            ;;
        s)
            echo -n "Enter search term: "
            read TERM
            if [ -n "$TERM" ]; then
                echo "--- Search Results ---"
                awk -v pat="$TERM" '$0 ~ pat {print "Line " NR ": " $0}' "$BUFFER"
                echo "----------------------"
                echo -n "Press Enter to return..."
                read _
            fi
            ;;
        i)
            echo ""
            echo "-- INSERT MODE (Type block, press Enter then Ctrl+D to finish) --"
            cat >> "$BUFFER"
            ;;
        I)
            echo ""
            echo -n "Insert before which line number? "
            read LINE_NUM
            if [ -n "$LINE_NUM" ]; then
                echo "-- INSERT MODE (Before line $LINE_NUM, Enter then Ctrl+D to finish) --"
                cat > "$INSERT_TMP"
                if [ -s "$INSERT_TMP" ]; then
                    if [ "$LINE_NUM" -le 1 ]; then
                        cat "$INSERT_TMP" "$BUFFER" > "$OUT_TMP"
                        mv "$OUT_TMP" "$BUFFER"
                    else
                        TARGET_LINE=$((LINE_NUM - 1))
                        sed -i "${TARGET_LINE}r $INSERT_TMP" "$BUFFER"
                    fi
                    rm -f "$INSERT_TMP" "$OUT_TMP"
                    START_LINE=$LINE_NUM
                fi
            fi
            ;;
        d)
            # Check for second 'd' to match 'dd'
            stty -icanon -echo
            NEXT_CHAR=$(dd bs=1 count=1 2>/dev/null)
            stty icanon echo
            
            if [ "$NEXT_CHAR" = "d" ]; then
                echo ""
                echo -n "Delete starting at which line number? "
                read LINE_NUM
                
                if [ -n "$LINE_NUM" ]; then
                    # Calculate end range based on the count requested
                    END_DEL=$((LINE_NUM + COUNT - 1))
                    sed -i "${LINE_NUM},${END_DEL}d" "$BUFFER"
                fi
            fi
            ;;
        w)
            cat "$BUFFER" > "$FILE"
            echo ""
            echo "\"$FILE\" written to disk."
            sleep 1
            ;;
        q)
            echo ""
            echo "Discarding unsaved changes."
            break
            ;;
        x)
            cat "$BUFFER" > "$FILE"
            echo ""
            echo "\"$FILE\" saved."
            break
            ;;
    esac
done

