#!/bin/sh

FILE="$1"
if [ -z "$FILE" ]; then
    echo "Usage: $0 <filename>"
    exit 1
fi

touch "$FILE"

DIR=$(dirname "$FILE")
BUFFER="$DIR/.$$.novi_buffer.tmp"
cat "$FILE" > "$BUFFER"

INSERT_TMP="$DIR/.$$.novi_insert.tmp"
OUT_TMP="$DIR/.$$.novi_out.tmp"

restore_term() {
    stty icanon echo
    rm -f "$BUFFER" "$INSERT_TMP" "$OUT_TMP"
}
trap restore_term EXIT INT TERM

# Track the current active line across the whole file
CURSOR=1
WINDOW_SIZE=20

while true; do
    TOTAL_LINES=$(awk 'END {print NR}' "$BUFFER")
    [ -z "$TOTAL_LINES" ] && TOTAL_LINES=0
    
    # Ensure cursor stays inside boundaries
    if [ "$CURSOR" -gt "$TOTAL_LINES" ]; then
        CURSOR=$TOTAL_LINES
    fi
    if [ "$CURSOR" -lt 1 ]; then
        CURSOR=1
    fi

    # Dynamically calculate the window around the cursor
    START_LINE=$(( ((CURSOR - 1) / WINDOW_SIZE) * WINDOW_SIZE + 1 ))
    END_LINE=$((START_LINE + WINDOW_SIZE - 1))
    if [ "$END_LINE" -gt "$TOTAL_LINES" ]; then
        END_LINE=$TOTAL_LINES
    fi

    clear
    echo "========================================================="
    echo " File: $FILE | Line: $CURSOR/$TOTAL_LINES (novi Mode)"
    echo "========================================================="
    
    if [ "$TOTAL_LINES" -gt 0 ]; then
        # Print lines and place a '>' visual anchor at the cursor line
        awk -v start="$START_LINE" -v end="$END_LINE" -v cur="$CURSOR" '
        NR>=start && NR<=end {
            prefix = (NR == cur) ? "> " : "  ";
            print prefix NR ": " $0;
        }' "$BUFFER"
    else
        echo "  (file is empty)"
    fi
    
    echo "========================================================="
    echo " Nav:  [j/k] Move Up/Down   [f/b] Page Down/Up   [50gg] Go to Line"
    echo " Keys: [i] Insert After     [I] Insert Before    [5dd] Delete Lines"
    echo " Exit: [w] Save             [q] Quit             [x] Save & Exit"
    echo "========================================================="
    echo -n ":"
    
    COUNT=""
    while true; do
        stty -icanon -echo
        CHAR=$(dd bs=1 count=1 2>/dev/null)
        stty icanon echo
        
        case "$CHAR" in
            [0-9])
                COUNT="${COUNT}${CHAR}"
                echo -n "$CHAR"
                ;;
            *)
                CMD="$CHAR"
                break
                ;;
        esac
    done

    NUM_VAL="$COUNT"
    [ -z "$COUNT" ] && COUNT=1

    case "$CMD" in
        j)
            # Move cursor down 1 line (multiplied by count if provided)
            CURSOR=$((CURSOR + COUNT))
            ;;
        k)
            # Move cursor up 1 line (multiplied by count if provided)
            CURSOR=$((CURSOR - COUNT))
            ;;
        f)
            # Page down
            CURSOR=$((CURSOR + (WINDOW_SIZE * COUNT)))
            ;;
        b)
            # Page up
            CURSOR=$((CURSOR - (WINDOW_SIZE * COUNT)))
            ;;
        g)
            stty -icanon -echo
            NEXT_CHAR=$(dd bs=1 count=1 2>/dev/null)
            stty icanon echo
            
            if [ "$NEXT_CHAR" = "g" ]; then
                if [ -n "$NUM_VAL" ]; then
                    CURSOR="$NUM_VAL"
                else
                    CURSOR=1
                fi
            fi
            ;;
        G)
            if [ -n "$NUM_VAL" ]; then
                CURSOR="$NUM_VAL"
            else
                CURSOR="$TOTAL_LINES"
            fi
            ;;
        i)
            echo ""
            echo "-- INSERT MODE (Append AFTER current line $CURSOR, Enter then Ctrl+D) --"
            cat > "$INSERT_TMP"
            if [ -s "$INSERT_TMP" ]; then
                sed -i "${CURSOR}r $INSERT_TMP" "$BUFFER"
                rm -f "$INSERT_TMP"
                # Move cursor to the start of your newly added block
                CURSOR=$((CURSOR + 1))
            fi
            ;;
        I)
            echo ""
            echo "-- INSERT MODE (Insert BEFORE current line $CURSOR, Enter then Ctrl+D) --"
            cat > "$INSERT_TMP"
            if [ -s "$INSERT_TMP" ]; then
                if [ "$CURSOR" -le 1 ]; then
                    cat "$INSERT_TMP" "$BUFFER" > "$OUT_TMP"
                    mv "$OUT_TMP" "$BUFFER"
                else
                    TARGET_LINE=$((CURSOR - 1))
                    sed -i "${TARGET_LINE}r $INSERT_TMP" "$BUFFER"
                fi
                rm -f "$INSERT_TMP" "$OUT_TMP"
            fi
            ;;
        d)
            stty -icanon -echo
            NEXT_CHAR=$(dd bs=1 count=1 2>/dev/null)
            stty icanon echo
            
            if [ "$NEXT_CHAR" = "d" ]; then
                if [ "$TOTAL_LINES" -gt 0 ]; then
                    END_DEL=$((CURSOR + COUNT - 1))
                    sed -i "${CURSOR},${END_DEL}d" "$BUFFER"
                fi
            fi
            ;;
        w)
            cat "$BUFFER" > "$FILE"
            echo ""
            echo "\"$FILE\" written to disk."
            sleep 1
            ;;
        q)
            echo ""
            echo "Discarding unsaved changes."
            break
            ;;
        x)
            cat "$BUFFER" > "$FILE"
            echo ""
            echo "\"$FILE\" saved."
            break
            ;;
    esac
done

