#!/bin/sh

if [ -z "$1" ]; then
    echo "Usage: $0 <HTTPS_URL> [-O filename.sh]"
    exit 1
fi

URL="$1"
FILE=""

# --- POSIX NATIVE OPTION PARSER ---
while [ $# -gt 0 ]; do
    case "$1" in
        -O|-o|-) FILE="$2"; shift 2 ;;
        *) URL="$1"; shift 1 ;;
    esac
done

# Extract name from the URL path if no flag was explicitly typed
if [ -z "$FILE" ]; then
    CLEAN_URL=$(echo "$URL" | cut -d'?' -f1)
    FILE=$(echo "$CLEAN_URL" | sed 's|/$||' | awk -F'/' '{print $NF}')
fi
if [ -z "$FILE" ] || [ "$FILE" = "-" ]; then
    FILE="download.out"
fi

# Max loop constraint to prevent infinite redirect loops
REDIRECT_DEPTH=0
MAX_REDIRECTS=5

while [ "$REDIRECT_DEPTH" -lt "$MAX_REDIRECTS" ]; do
    HOST=$(echo "$URL" | sed -e 's|https://||' -e 's|http://||' | cut -d'/' -f1)
    PATH_TARGET=$(echo "$URL" | sed -e 's|https://||' -e 's|http://||' | cut -d'/' -f2- | sed 's|^|/|')

    echo "Connecting securely via OpenSSL..."
    echo "Host: $HOST"
    echo "Path: $PATH_TARGET"
    echo "----------------------------------------"

    # Fetch headers and body separately into a temp processing file
    TMP_RAW="/tmp/nowget_raw_$$.tmp"
    
    (
        printf "GET %s HTTP/1.1\r\n" "$PATH_TARGET"
        printf "Host: %s\r\n" "$HOST"
        printf "User-Agent: nowget-raw/1.0\r\n"
        printf "Connection: close\r\n\r\n"
    ) | openssl s_client -connect "${HOST}:443" -servername "$HOST" -quiet 2>/dev/null > "$TMP_RAW"

    # Check for HTTP redirect codes (301, 302, 307, 308) in the first line
    HTTP_STATUS=$(head -n 1 "$TMP_RAW" | awk '{print $2}')

    case "$HTTP_STATUS" in
        301|302|303|307|308)
            # Extract the redirected target URL from the headers safely
            # Using tr to purge system \r characters from HTTP definitions
            NEW_LOCATION=$(grep -i '^Location:' "$TMP_RAW" | head -n 1 | awk '{print $2}' | tr -d '\r')
            
            if [ -n "$NEW_LOCATION" ]; then
                echo "Redirect detected ($HTTP_STATUS) -> Following to: $NEW_LOCATION"
                URL="$NEW_LOCATION"
                REDIRECT_DEPTH=$((REDIRECT_DEPTH + 1))
                rm -f "$TMP_RAW"
                continue
            fi
            ;;
    esac

    # If no redirection is detected, drop server header blocks and commit body stream data
    awk '
        BEGIN { in_body = 0 }
        {
            sub(/\r$/, "")
            if (in_body) {
                print $0
            } else {
                if ($0 == "") {
                    in_body = 1
                }
            }
        }
    ' "$TMP_RAW" > "$FILE"
    
    rm -f "$TMP_RAW"
    break
done

if [ "$REDIRECT_DEPTH" -eq "$MAX_REDIRECTS" ]; then
    echo "Error: Maximum redirect execution limit exceeded ($MAX_REDIRECTS)."
    exit 1
fi

if [ -s "$FILE" ]; then
    echo "----------------------------------------"
    echo "Download complete: Success ($FILE)."
else
    echo "Error: Could not retrieve secure file data blocks."
    rm -f "$FILE"
    exit 1
fi

