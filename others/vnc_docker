docker run -p 6080:80 -p 5900:5900 -e USER=k -e PASSWORD=mypassword -v /dev/shm:/dev/shm dorowu/ubuntu-desktop-lxde-vnc #user k, can add -e VNC_PASSWORD=mypassword if needed.

